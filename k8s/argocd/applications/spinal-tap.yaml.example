apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: spinal-tap
  namespace: argocd
spec:
  destination:
    namespace: spinal-tap
    server: https://kubernetes.default.svc
  project: spinal-tap
  source:
    path: .
    repoURL: oci://ghcr.io/deeplearnphysics/spinal-tap-deploy
    targetRevision: REPLACE_WITH_VALIDATED_OCI_SHA256_DIGEST
  syncPolicy:
    syncOptions:
    - FailOnSharedResource=true
    - RespectIgnoreDifferences=true
